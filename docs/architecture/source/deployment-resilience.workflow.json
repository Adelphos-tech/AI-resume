  "cards": [
    {
      "dot": "amber",
      "title": "What is automated vs manual",
      "items": [
        "Automated: build, postgres health wait, one-shot migrate, app health curl loop",
        "Manual: backup.sh must be run by the operator before deploy (deploy.sh comments instruct it)",
        "Manual: no restore script, no rollback path \u2014 a failed health check leaves the new app container up and exits non-zero",
        "Postgres exposes no host port; app binds 127.0.0.1:3100 \u2014 volumes survive container recreation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backup scope & limits",
      "items": [
        "pg_dump -Fc custom format + tar.gz of the /app/.data named volume + SHA256SUMS manifest",
        "Sequential, not a coordinated snapshot \u2014 a deployment-time backup set, not point-in-time consistent",
        "No retention/pruning and no restore verification \u2014 checksums are written, never re-checked"
      ]
    }
  ]
