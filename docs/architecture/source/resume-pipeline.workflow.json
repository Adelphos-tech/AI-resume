  "cards": [
    {
      "dot": "emerald",
      "title": "Deterministic only",
      "items": [
        "Extraction = unpdf/mammoth + text normalization \u2014 no interpretation (extract-resume.ts:39)",
        "Structuring is pure rules \u2014 'no AI, no fuzzy matching' (parse-resume.ts:5)",
        "No Groq call exists anywhere in the import path",
        "Review screen renders the structured draft \u2014 candidate sees the parsed sections, not raw text"
      ]
    },
    {
      "dot": "amber",
      "title": "Write boundary",
      "items": [
        "Nothing reaches MasterCareerProfile until the candidate confirms",
        "Confirm re-checks the reviewed extraction sha256 (stale-review guard)",
        "Basics fill empty fields only \u2014 existing canonical values are never overwritten",
        "Sections append with duplicate keys skipped (ImportSummary counts)"
      ]
    },
    {
      "dot": "violet",
      "title": "Variant snapshot",
      "items": [
        "profileSnapshot + resumeData are composed server-side at create time",
        "No update/edit function exists for ResumeVariant rows (logical immutability)",
        "Later MCP edits cannot reach an existing variant"
      ]
    }
  ]
