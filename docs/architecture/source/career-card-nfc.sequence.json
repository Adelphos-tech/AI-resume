  "cards": [
    {
      "dot": "amber",
      "title": "Token is routing, not auth",
      "items": [
        "192-bit opaque token \u2014 unrelated to candidate/profile ids",
        "Possession grants nothing: isActive + isPublished still gate the redirect",
        "Token never rotates on slug, content, or theme changes \u2014 only link create writes it"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the visitor receives",
      "items": [
        "Server-built public DTO \u2014 no Prisma rows, MCP data, ids, or storage keys",
        "Email/phone/WhatsApp only when the candidate's visibility flags allow",
        "Media served via /u/<slug>/photo + /cover routes \u2014 keys never exposed"
      ]
    },
    {
      "dot": "cyan",
      "title": "NFC is convenience, not security",
      "items": [
        "Web NFC NDEF url record \u2014 plain text URL, no cryptographic tag binding",
        "Verify mode compares scanned URL to shareUrl: verified / wrong / empty",
        "Tag UID is not read or stored; nothing NFC-related persists server-side"
      ]
    }
  ]
