
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("STAFF")
  sessions      Session[]
  accounts      Account[]
  candidate     Candidate?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CandidatePackage {
  STARTER_LAP
  CAREER_GRID
  POLE_POSITION
}

enum CandidateStatus {
  NEW
  INTAKE_PENDING
  IN_REVIEW
  IN_PROGRESS
  READY_FOR_DELIVERY
  DELIVERED
  ARCHIVED
}

model Candidate {
  id           String                 @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  location     String?
  linkedinUrl  String?
  package      CandidatePackage
  status       CandidateStatus        @default(NEW)
  userId       String?                @unique
  user         User?                  @relation(fields: [userId], references: [id])
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  intakeAccess CandidateIntakeAccess?
  intake       CandidateIntake?
  resumeSource CandidateResumeSource?
  careerProfile MasterCareerProfile?
  resumeVariants ResumeVariant[]
  publicProfile PublicProfile?

  @@index([status])
  @@index([createdAt])
  @@map("candidate")
}

enum WorkplacePreference {
  REMOTE
  HYBRID
  ONSITE
  FLEXIBLE
}

enum EmploymentPreference {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model CandidateIntake {
  id                    String                 @id @default(cuid())
  candidateId           String                 @unique
  currentRole           String?
  targetRoles           String[]
  preferredLocations    String[]
  workplacePreferences  WorkplacePreference[]
  employmentPreferences EmploymentPreference[]
  salaryExpectation     Int?
  salaryCurrency        String?
  workAuthorization     String?
  requiresSponsorship   Boolean?
  preferredIndustries   String[]
  careerGoals           String?
  additionalNotes       String?
  submittedAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  candidate             Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_intake")
}

model CandidateResumeSource {
  id               String   @id @default(cuid())
  candidateId      String   @unique
  originalFileName String
  storageKey       String   @unique
  mimeType         String
  sizeBytes        Int
  sha256           String
  uploadedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt
  candidate        Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  extraction       CandidateResumeExtraction?

  @@map("candidate_resume_source")
}

enum ResumeExtractionStatus {
  SUCCEEDED
  NO_TEXT
  FAILED
}

model CandidateResumeExtraction {
  id             String                 @id @default(cuid())
  resumeSourceId String                 @unique
  sourceSha256   String
  status         ResumeExtractionStatus
  extractedText  String?
  pageCount      Int?
  characterCount Int?
  parser         String?
  errorCode      String?
  extractedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  resumeSource   CandidateResumeSource  @relation(fields: [resumeSourceId], references: [id], onDelete: Cascade)

  @@map("candidate_resume_extraction")
}

model MasterCareerProfile {
  id            String   @id @default(cuid())
  candidateId   String   @unique
  schemaVersion Int
  profileData   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("master_career_profile")
}

model CandidateIntakeAccess {
  id          String    @id @default(cuid())
  candidateId String    @unique
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_intake_access")
}

model ResumeVariant {
  id                   String   @id @default(cuid())
  candidateId          String
  name                 String
  targetRole           String
  targetCountry        String
  templateKey          String
  profileSchemaVersion Int
  profileSnapshot      Json
  resumeData           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  featuredOnPublicProfiles PublicProfile[] @relation("FeaturedPublicResume")

  @@index([candidateId])
  @@map("resume_variant")
}

model PublicProfile {
  id          String   @id @default(cuid())
  candidateId String   @unique
  slug        String   @unique
  isPublished Boolean  @default(false)
  // Public presentation layer — canonical career data stays in
  // MasterCareerProfile. Career-section visibility defaults to false so
  // existing profiles never leak MCP data on upgrade.
  publicHeadline String?
  publicBio      String?
  publicLocation String?
  currentFocus   String?
  workAuthorization String?
  openToOpportunities Boolean @default(false)
  // Presentation theme — curated app-owned registry, resolved defensively.
  themeId             String @default("role-race-classic")
  // Career Card accent color — curated registry id only (never a CSS
  // value). Emerald preserves the pre-7A4E signature appearance.
  accentColorId       String @default("emerald")
  // Career Card presentation style — curated registry id only.
  // "standard" preserves the pre-7A4F1 appearance exactly.
  cardStyleId         String @default("standard")
  // Opaque storage key for the normalized profile photo — never a path,
  // filename, or URL. Null → initials avatar.
  profilePhotoKey     String?
  // Photo presentation metadata — non-destructive; master image unchanged.
  profilePhotoFocalX  Float  @default(0.5)
  profilePhotoFocalY  Float  @default(0.5)
  profilePhotoZoom    Float  @default(1.0)
  // Opaque storage key for the normalized cover photo — never a path,
  // filename, or URL. Null → theme's existing no-cover hero.
  coverPhotoKey       String?
  // Cover presentation metadata — non-destructive; master image unchanged.
  coverPhotoFocalX    Float  @default(0.5)
  coverPhotoFocalY    Float  @default(0.5)
  coverPhotoZoom      Float  @default(1.0)
  showExperience      Boolean @default(false)
  showEducation       Boolean @default(false)
  showSkills          Boolean @default(false)
  showProjects        Boolean @default(false)
  showCertifications  Boolean @default(false)
  showLanguages       Boolean @default(false)
  linkedinUrl         String?
  githubUrl           String?
  websiteUrl          String?
  featuredResumeVariantId String?
  featuredResumeVariant   ResumeVariant? @relation("FeaturedPublicResume", fields: [featuredResumeVariantId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  links       PublicProfileLink[]
  company     CompanyProfile?

  @@map("public_profile")
}

// Optional company identity attached 0..1 to a PublicProfile. Not a
// separate account/tenant — additional presentation data managed by the
// candidate. Never public until isVisible is explicitly true.
model CompanyProfile {
  id              String       @id @default(cuid())
  publicProfileId String       @unique
  // identity
  companyName     String
  tagline         String?
  // media — opaque storage key, never a path/filename/URL
  companyLogoKey  String?
  // contact (privacy-gated by the show* flags below)
  contactPersonName String?
  contactPersonRole String?
  publicPhone     String?
  publicEmail     String?
  whatsappNumber  String?
  // links
  websiteUrl      String?
  linkedinUrl     String?
  facebookUrl     String?
  instagramUrl    String?
  xUrl            String?
  youtubeUrl      String?
  tiktokUrl       String?
  // company information
  about           String?
  industry        String?
  // structured lists — Postgres scalar arrays, bounded in validation
  locations       String[]
  services        String[]
  // opportunity/company actions
  hiringOpen         Boolean @default(false)
  openRolesSummary   String?
  openRolesUrl       String?
  companyProfileSummary String?
  companyProfileUrl     String?
  // contact visibility — independent per-field controls, never inferred
  showPublicPhone      Boolean @default(false)
  showPublicEmail      Boolean @default(false)
  showWhatsapp         Boolean @default(false)
  showContactPerson    Boolean @default(false)
  // master visibility — company stays private until explicitly enabled
  isVisible            Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publicProfile PublicProfile @relation(fields: [publicProfileId], references: [id], onDelete: Cascade)

  @@map("company_profile")
}

model PublicProfileLink {
  id              String   @id @default(cuid())
  publicProfileId String   @unique
  token           String   @unique
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publicProfile   PublicProfile @relation(fields: [publicProfileId], references: [id], onDelete: Cascade)

  @@map("public_profile_link")
}
