# RoleRace production environment — copy to .env.production on the VPS
# and fill real values. NEVER commit .env.production.
#
# Generate secrets (URL-safe, no encoding problems inside DATABASE_URL):
#   openssl rand -hex 32

# --- PostgreSQL (private Docker network only, host name: postgres) ---
POSTGRES_DB=rolerace
POSTGRES_USER=rolerace
POSTGRES_PASSWORD=<GENERATE_URL_SAFE_PASSWORD>

# App → DB over the private Compose network. Password must be identical
# (and URL-safe so no percent-encoding is needed).
DATABASE_URL=postgresql://rolerace:<SAME_AS_POSTGRES_PASSWORD>@postgres:5432/rolerace

# --- Auth ---
# openssl rand -hex 32
BETTER_AUTH_SECRET=<GENERATE_64_HEX_CHARS>
BETTER_AUTH_URL=https://app.rolerace.com

# --- Public sharing ---
# Canonical origin for permanent Career Card / NFC links.
PUBLIC_SHARE_ORIGIN=https://go.rolerace.com

# --- PDF export ---
# Origin Chromium reaches from INSIDE the container — loopback, not the
# public domain.
PDF_RENDER_ORIGIN=http://127.0.0.1:3000

# --- AI review (optional — feature degrades gracefully without a key) ---
GROQ_API_KEY=<REAL_GROQ_API_KEY>
# GROQ_MODEL=openai/gpt-oss-120b

NODE_ENV=production

# Rollback-friendly image tag; set to the deployed git SHA, e.g. f5abe57.
ROLERACE_IMAGE_TAG=latest
