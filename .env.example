# Local development environment for RoleRace.
# Copy to .env and set real values. .env is never committed.

# PostgreSQL container (docker-compose.yml)
POSTGRES_DB=rolerace
POSTGRES_USER=rolerace
POSTGRES_PASSWORD=CHANGE_ME
# Host port the database is exposed on (localhost only).
POSTGRES_PORT=5432

# Application
# Full connection string used by Prisma/app. Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://rolerace:CHANGE_ME@127.0.0.1:5432/rolerace

# Authentication (Better Auth)
# Random secret of at least 32 characters, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=CHANGE_ME_min_32_characters
BETTER_AUTH_URL=http://localhost:3000

# Public sharing (server-only, never NEXT_PUBLIC_)
# Canonical origin for permanent Career Card / NFC links — independent of
# BETTER_AUTH_URL so app and share domains can diverge in production
# (e.g. app.rolerace.com vs go.rolerace.com).
PUBLIC_SHARE_ORIGIN=http://localhost:3000

# Resume PDF export (server-only, never NEXT_PUBLIC_)
# Origin Chromium uses to reach the internal print surface. Defaults to
# http://localhost:3000. In Docker/production set this to the app's own
# reachable origin — it must resolve *from inside the server process*.
PDF_RENDER_ORIGIN=http://localhost:3000

# AI resume review (server-side only, optional)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
