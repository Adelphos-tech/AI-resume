{
  "name": "rolerace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && next dev",
    "build": "pnpm db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && pnpm db:generate && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:status": "docker compose ps",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "admin:create": "NODE_OPTIONS='--conditions=react-server' tsx scripts/create-admin.ts",
    "auth:generate": "pnpm dlx auth@1.7.5 generate --config scripts/auth-cli.ts --output prisma/schema.prisma --adapter prisma --dialect postgresql -y"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.5",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "1.7.5",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "dotenv": "^18.0.1",
    "file-type": "^22.1.1",
    "lucide-react": "^1.47.0",
    "mammoth": "1.12.3",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "prisma": "^7.10.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5"
}
